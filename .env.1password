# 1Password references for the MOP release secrets, resolved by `op run`.
# Vault "DesgnSpace": "Apple-signing" and "R2-downloads" are shared across apps;
# "com.desgnspace.mop" holds what only MOP needs.
APPLE_SIGNING_IDENTITY=op://DesgnSpace/Apple-signing/APPLE_SIGNING_IDENTITY
APPLE_ID=op://DesgnSpace/Apple-signing/APPLE_ID
APPLE_PASSWORD=op://DesgnSpace/Apple-signing/APPLE_PASSWORD
APPLE_TEAM_ID=op://DesgnSpace/Apple-signing/APPLE_TEAM_ID
R2_ACCOUNT_ID=op://DesgnSpace/R2-downloads/R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=op://DesgnSpace/R2-downloads/R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=op://DesgnSpace/R2-downloads/R2_SECRET_ACCESS_KEY
R2_BUCKET=op://DesgnSpace/R2-downloads/R2_BUCKET
R2_PUBLIC_BASE_URL=op://DesgnSpace/R2-downloads/R2_PUBLIC_BASE_URL
SPARKLE_PRIVATE_KEY=op://DesgnSpace/com.desgnspace.mop/SPARKLE_PRIVATE_KEY
SPARKLE_PUBLIC_KEY=op://DesgnSpace/com.desgnspace.mop/SPARKLE_PUBLIC_KEY
CLOUDFLARE_DEPLOY_HOOK_URL=op://DesgnSpace/com.desgnspace.mop/CLOUDFLARE_DEPLOY_HOOK_URL
MINIMUM_SYSTEM_VERSION=op://DesgnSpace/com.desgnspace.mop/MINIMUM_SYSTEM_VERSION
