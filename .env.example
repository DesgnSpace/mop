# Copy to .env and fill locally. Never commit .env.

# Cloudflare R2 bucket write access.
# The bucket is shared across products: every MOP object is stored under the
# R2_KEY_PREFIX below, so other products can use their own prefixes later.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-shared-bucket-name

# Public base URL serving R2_BUCKET.
R2_PUBLIC_BASE_URL=https://downloads.desgn.space

# Key prefix for all MOP objects (mop/MOP-x.y.z.dmg, mop/appcast.xml, ...).
R2_KEY_PREFIX=mop

# Migration mirror. Old installs keep polling the OLD domain for appcast.xml.
# While any of those installs are still active, set this to the old bucket so
# each release also republishes the appcast there (its download URLs point at
# the new domain, so old installs migrate on their next update). Unset to stop.
R2_LEGACY_BUCKET=mop-releases
# Public URL that serves R2_LEGACY_BUCKET (used only in messages).
R2_LEGACY_PUBLIC_BASE_URL=https://downloads.mop.desgn.space

# Optional. If set, release publish triggers a landing rebuild after R2 upload.
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxx

# Optional. Defaults to 14.0.
MINIMUM_SYSTEM_VERSION=14.0

# Sparkle EdDSA signing. Use one of these if Sparkle key is not in Keychain.
SPARKLE_PRIVATE_KEY_FILE=/absolute/path/to/sparkle_private_key
# SPARKLE_PRIVATE_KEY=base64-or-raw-private-key-from-generate_keys

# Must match the private key used above. Needed in app Info.plist at build time.
SPARKLE_PUBLIC_KEY=public-key-from-generate_keys-p
