# Copy to .env and fill locally. Never commit .env.

# Cloudflare R2 bucket write access.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=mop-releases

# Public read URL for the R2 bucket/custom domain.
R2_PUBLIC_BASE_URL=https://downloads.mop.desgn.space

# Optional. If set, release publish triggers a landing rebuild after R2 upload.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx

# Optional. Defaults to 14.0.
MINIMUM_SYSTEM_VERSION=14.0
